{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "lib": ["ES2022"],
    "rootDir": "Source",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node", "vscode", "mocha"]
  },
  "include": ["Source/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
